NODE_ENV=production
PORT=3000

SITE_NAME=Cory Brown Wholesale
SITE_URL=https://your-domain.com
OG_IMAGE=https://your-image-url.com/og-image.jpg
GOOGLE_SITE_VERIFICATION=
# Indexing stays blocked unless every required public business field below is present.
ENABLE_INDEXING=false

BUSINESS_EMAIL=sales@example.com
BUSINESS_PHONE=253-555-0100
BUSINESS_ADDRESS=123 Business Street, Tacoma, WA 98444
BUSINESS_LICENSE_NUMBER=REPLACE_WITH_VERIFIED_WA_LICENSE
PRIVACY_EMAIL=privacy@example.com

DATABASE_URL=postgresql://user:password@host:5432/database
PGSSL=false
PG_POOL_MAX=10

ADMIN_EMAIL=admin@example.com
# Use ADMIN_PASSWORD_HASH in production. ADMIN_PASSWORD is a temporary fallback.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
SESSION_SECRET=replace-with-at-least-32-random-characters

SALES_EMAIL=sales@example.com
RESEND_API_KEY=
EMAIL_FROM=Orders <orders@your-domain.com>
# Required in every commercial campaign email under CAN-SPAM.
BUSINESS_POSTAL_ADDRESS=123 Business Street, Tacoma, WA 98444

# Internal operational alerts and daily digest.
AUTOMATION_ALERT_EMAIL=admin@example.com
AUTOMATION_TIME_ZONE=America/Los_Angeles
# Minimum 60000. Default is 300000 (five minutes).
AUTOMATION_INTERVAL_MS=300000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cory-wholesale-products
