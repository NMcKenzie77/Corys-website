NODE_ENV=production
PORT=3000

# Verified public dispensary information. Indexing stays blocked until all required values are real.
SITE_NAME=Your Dispensary Trade Name
SITE_URL=https://your-final-domain.com
OG_IMAGE=https://your-final-domain.com/images/social-card.jpg
GOOGLE_SITE_VERIFICATION=
ENABLE_INDEXING=false

BUSINESS_EMAIL=store@example.com
BUSINESS_PHONE=253-555-0100
BUSINESS_ADDRESS=123 Licensed Store Street, Tacoma, WA 98444
BUSINESS_LICENSE_NUMBER=REPLACE_WITH_VERIFIED_WA_RETAIL_LICENSE
BUSINESS_POSTAL_ADDRESS=123 Licensed Store Street, Tacoma, WA 98444
PRIVACY_EMAIL=privacy@example.com
STORE_HOURS=Daily 8:00 a.m. to 10:00 p.m.
# Comma-separated choices shown on the pickup reservation form.
PICKUP_WINDOWS=ASAP,Within 1 hour,Later today
PICKUP_INSTRUCTIONS=Wait for the ready notice. Bring an acceptable unexpired government-issued photo ID. Payment and final sale occur inside the licensed store.

DATABASE_URL=postgresql://user:password@host:5432/database
PGSSL=false
PG_POOL_MAX=10

ADMIN_EMAIL=admin@example.com
# Use ADMIN_PASSWORD_HASH in production. ADMIN_PASSWORD is only a temporary fallback.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
SESSION_SECRET=replace-with-at-least-32-random-characters

# Reservation notices and customer email are sent by ARKON Platform.
# Cory never holds Resend/SMTP credentials.
SALES_EMAIL=store@example.com
ARKON_PLATFORM_URL=https://platform.arkonsysai.com
ARKON_PLATFORM_SERVICE_KEY=
CORY_RUNTIME_KEY=cannabis-retail-shared
# Required in production so a Platform handoff cannot cross Cory tenants.
CORY_PLATFORM_CLIENT_COMPANY_ID=

# Internal operational alerts and daily digest.
AUTOMATION_ALERT_EMAIL=admin@example.com
AUTOMATION_TIME_ZONE=America/Los_Angeles
AUTOMATION_INTERVAL_MS=300000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dispensary-products

# This application intentionally has no online cannabis payment, shipping, or delivery credentials.
# In-store providers such as cash, POS, or Safe Harbor may be recorded when staff completes the sale.
